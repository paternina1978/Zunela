# ZUNELA — modo de persistencia
# local (por defecto): todo en el navegador, como el MVP actual
# supabase: Auth + tablas compartidas (aplicar supabase/migrations/001–018)
NEXT_PUBLIC_ZUNELA_BACKEND=local

# Solo si NEXT_PUBLIC_ZUNELA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_...) o legacy anon (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# En cloud: Site URL + Redirect URLs deben incluir /auth/callback
# Nunca secret/service_role en el cliente
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
